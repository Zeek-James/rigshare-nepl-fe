{
  "name": "rigshare-mono",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start:operators",
    "start:operators": "REACT_APP_ROLE=operators npm run start --workspace=@rigshare/main",
    "start:admin": "REACT_APP_ROLE=admin npm run start --workspace=@rigshare/main",
    "build": "npm run build:operators",
    "build:operators": "REACT_APP_ROLE=operators npm run build --workspace=@rigshare/main",
    "build:admin": "REACT_APP_ROLE=admin npm run build --workspace=@rigshare/main",
    "build:all": "npm run build:admin && npm run build:operators",
    "test": "npm run test --workspaces",
    "test:main": "npm run test --workspace=@rigshare/main",
    "install:all": "npm install --workspaces"
  }
}
